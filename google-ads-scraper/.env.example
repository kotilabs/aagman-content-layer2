# Browser behavior
HEADLESS=true
DELAY_SECONDS=2
MAX_ADS=0

# Output
OUTPUT_DIR=output

# Kimi API credentials and model (used for text analysis)
KIMI_CODE_CREDENTIALS=/Users/aryansinha/.kimi-code/credentials/kimi-code.json
KIMI_BASE_URL=https://api.kimi.com/coding/v1
KIMI_MODEL=k3

# OpenRouter vision settings (used for cheap ad image descriptions)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
